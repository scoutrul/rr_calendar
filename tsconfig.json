{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "env.d.ts",
    "main.ts",
    "App.vue",
    "composables/**/*.ts",
    "components/**/*.vue",
    "components/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/node_modules/**",
    "vite.config.ts",
    "*.config.ts",
    "angular/**"
  ],
  "references": [{ "path": "./tsconfig.node.json" }],
  "vueCompilerOptions": {
    "target": 3,
    "experimentalDisableTemplateSupport": false
  }
}

